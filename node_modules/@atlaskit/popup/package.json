{
	"name": "@atlaskit/popup",
	"version": "10.2.4",
	"description": "A popup displays brief content in an overlay.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"tags": [
				"platform-labs"
			],
			"name": "Popup",
			"category": "Overlays and layering"
		}
	},
	"dependencies": {
		"@atlaskit/css": "^1.1.0",
		"@atlaskit/ds-lib": "^8.0.0",
		"@atlaskit/layering": "^6.1.0",
		"@atlaskit/motion": "^10.0.0",
		"@atlaskit/platform-feature-flags": "^2.2.0",
		"@atlaskit/popper": "^9.4.0",
		"@atlaskit/portal": "^7.1.0",
		"@atlaskit/primitives": "^22.7.0",
		"@atlaskit/react-compiler-gating": "^0.2.0",
		"@atlaskit/tokens": "^20.12.0",
		"@atlaskit/top-layer": "^8.0.0",
		"@babel/runtime": "^7.0.0",
		"@compiled/react": "^1.0.2",
		"bind-event-listener": "^3.0.0",
		"focus-trap": "^2.4.5",
		"memoize-one": "^6.0.0",
		"tiny-invariant": "^1.2.0"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/accessibility-testing": "workspace:^",
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/banner": "^15.3.0",
		"@atlaskit/button": "^25.8.0",
		"@atlaskit/code": "^20.0.0",
		"@atlaskit/datetime-picker": "^19.4.0",
		"@atlaskit/docs": "^12.3.0",
		"@atlaskit/dropdown-menu": "^21.3.0",
		"@atlaskit/form": "^18.3.0",
		"@atlaskit/heading": "^8.0.0",
		"@atlaskit/icon": "^38.1.0",
		"@atlaskit/link": "^5.1.0",
		"@atlaskit/menu": "^11.0.0",
		"@atlaskit/modal-dialog": "^17.2.0",
		"@atlaskit/radio": "^10.2.0",
		"@atlaskit/section-message": "^10.3.0",
		"@atlaskit/select": "^23.2.0",
		"@atlaskit/textfield": "^10.3.0",
		"@atlaskit/toggle": "^17.3.0",
		"@atlaskit/visually-hidden": "^4.4.0",
		"@atlassian/feature-flags-test-utils": "^1.3.0",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/testing-library": "^0.12.0",
		"@atlassian/workbench": "workspace:*",
		"ast-types": "^0.14.2",
		"jscodeshift": "^17.0.0",
