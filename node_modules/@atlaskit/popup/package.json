		},
		"platform-design-system-popup-ref": {
			"type": "boolean"
		},
		"platform-design-system-apply-popup-wrapper-focus": {
			"type": "boolean"
		},
		"popup-onclose-fix": {
			"type": "boolean"
		},
		"platform_dst_nested_escape": {
			"type": "boolean"
		},
		"platform-dst-motion-uplift-popup": {
			"type": "boolean"
		},
		"platform_dst-popup-trigger-initial-focus-ref": {
			"type": "boolean"
		},
		"platform-dst-popup-trigger-focus-fix": {
			"type": "boolean"
		}
	},
	"homepage": "https://atlassian.design/components/popup/"
}
