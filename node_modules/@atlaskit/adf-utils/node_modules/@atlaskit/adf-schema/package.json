{
	"name": "@atlaskit/adf-schema",
	"version": "57.7.44",
	"description": "Shared package that contains the ADF-schema (json) and ProseMirror node/mark specs",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-monorepo",
	"atlassian": {
		"team": "Editor: Lego",
		"prTasks": [
			"For ADF changes, I have assessed compatibility with existing documents and deployed consumers, recorded required upgrades and rollout order in the proposal, and checked that disabling the experiment preserves saved ADF, including through any fallback. See https://hello.atlassian.net/wiki/spaces/EDITOR/pages/3693372087."
		]
	},
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": false,
	"atlaskit:src": "src/index.ts",
	"scripts": {
		"clean:build": "rm -rf dist",
		"ak-postbuild": "afm run build:move:json-schema",
		"test": "afm run test:unit",
		"test:unit": "afm workspace @atlaskit/editor-prosemirror build && jest --testPathPattern=packages/adf-schema/ --config=../../jest.config.js",
		"test:json-schema": "jest --expand --testPathPattern=packages/adf-schema/schema-generators/__tests__/unit/json-full-schema.unit.ts --config=../../jest.config.js",
		"build:cjs": "NODE_ENV=production BABEL_ENV=production:node-cjs babel --config-file ./babel.config.js src --out-dir dist/cjs -x .ts,.tsx",
		"build:esm": "NODE_ENV=production BABEL_ENV=production:esm babel --config-file ./babel.config.js src -d dist/esm -x .ts,.tsx",
		"build:es2019": "NODE_ENV=production BABEL_ENV=production:es2019 babel --config-file ./babel.config.js src -d dist/es2019 -x .ts,.tsx",
		"build:types": "NODE_ENV=production tsc --project ./build/tsconfig.json --emitDeclarationOnly --outDir ./dist/types --rootDir ./src && afm run build:jsontypes",
		"build:jsontypes": "mkdir -p dist/types/json-schema && cp src/json-schema/index.ts dist/types/json-schema/index.d.ts",
		"build:all": "afm run build:cjs && afm run build:esm && afm run build:es2019 && afm run build:types",
		"build": "afm run clean:build && afm workspace @atlaskit/editor-prosemirror build && afm workspace @atlaskit/adf-schema-generator build && afm run build:all && afm run build:schema:all",
		"build:move:json-schema": "mkdir -p dist && cp -r json-schema dist",
		"build:schema:pm": "run-ts ./schema-generators/pm-full-schema.ts && prettier --write --no-editorconfig './src/next-schema/generated/**/*.ts'",
		"build:schema:json": "mkdir -p json-schema/v1/ && run-ts ./schema-generators/json-full-schema.ts && prettier --write --no-editorconfig './json-schema/v1/*.json' && afm run build:move:json-schema",
		"build:schema:validator": "run-ts ./schema-generators/validator-full-schema.ts && prettier --write --no-editorconfig './src/validator-schema/generated/**/*.ts'",
		"build:schema:all": "afm run build:schema:pm && afm run build:schema:json && afm run build:schema:validator"
	},
	"dependencies": {
		"@atlaskit/adf-schema-generator": "^4.0.0",
		"@atlaskit/editor-prosemirror": "^9.0.0",
		"@atlaskit/platform-feature-experiments": "^0.3.0",
		"@atlaskit/platform-feature-flags": "^2.2.0",
		"@atlaskit/tmp-editor-statsig": "^264.0.0",
		"@babel/runtime": "^7.0.0",
		"css-color-names": "0.0.4",
		"linkify-it": "^5.0.2",
		"memoize-one": "^6.0.0"
	},
	"platform-feature-flags": {
		"cc_maui_annotations_on_extensions": {
			"type": "boolean",
			"referenceOnly": true
		},
		"platform_bugfix_invalid_urls_parsing_in_editor": {
			"type": "boolean"
		}
	},
	"devDependencies": {
		"@af/adf-test-helpers": "workspace:^",
		"@atlaskit/codemod-utils": "^5.2.0",
		"@atlassian/adf-schema-json": "^1.35.0",
		"@atlassian/atlassian-frontend-prettier-config-1.0.1": "npm:@atlassian/atlassian-frontend-prettier-config@1.0.1",
		"@atlassian/experiment-test-utils": "^0.2.0",
		"@atlassian/feature-flags-test-utils": "^1.3.0",
		"@atlassian/ts-loader": "^0.1.0",
		"@babel/cli": "^7.20.0",
		"@babel/core": "7.24.9",
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
		"@babel/plugin-proposal-object-rest-spread": "^7.20.0",
		"@babel/plugin-proposal-optional-chaining": "^7.20.0",
		"@babel/plugin-syntax-dynamic-import": "^7.8.3",
		"@babel/plugin-transform-runtime": "^7.20.0",
		"@babel/preset-env": "^7.20.0",
		"@babel/preset-react": "^7.29.7",
		"@babel/preset-typescript": "^7.20.0",
		"@compiled/babel-plugin": "^3.0.2",
		"@manypkg/find-root": "^1.1.0",
		"@types/jest": "^30.0.0",
		"@types/linkify-it": "^5.0.0",
		"@types/node": "^24.0.0",
		"@typescript-eslint/parser": "^8.64.0",
		"babel-plugin-transform-define": "^2.0.0",
		"better-ajv-errors": "^0.6.7",
		"eslint": "^8.57.0",
		"jest": "^30.5.1",
		"jest-environment-jsdom": "^30.5.1",
		"json-schema-diff-validator": "^0.4.1",
		"prettier": "^3.2.5",
		"react-dom": "^19.2.0",
		"react-magnetic-di": "^3.1.4",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"prettier": "@atlassian/atlassian-frontend-prettier-config-1.0.1"
}
