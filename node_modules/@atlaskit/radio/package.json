		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.4.3",
		"jscodeshift": "^17.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.2.0"
