{
	"name": "@atlaskit/layering",
	"version": "6.1.0",
	"description": "Layering provides consistent and accessible layered experience",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"website": {
			"tags": [
				"platform-labs"
			],
			"status": {
				"type": "deprecated",
				"description": "This package is deprecated. The browser top layer handles stacking and Escape natively. Use [top layer](/components/top-layer), and `hasOpenDialogOrPopover` from `@atlaskit/top-layer/page-surface/has-open-dialog-or-popover` to check whether an overlay is open."
			}
		},
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"singleton": true
	},
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"dependencies": {
		"@atlaskit/react-compiler-gating": "^0.2.0",
		"@babel/runtime": "^7.0.0",
		"bind-event-listener": "^3.0.0",
		"tiny-invariant": "^1.2.0"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@atlaskit/button": "^25.6.0",
		"@atlaskit/modal-dialog": "^17.1.0",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/workbench": "workspace:*",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.4.3",
		"react": "^19.0.0"
	},
	"homepage": "https://atlassian.design/components"
}
