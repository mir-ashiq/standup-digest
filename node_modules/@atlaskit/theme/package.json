{
	"name": "@atlaskit/theme",
	"version": "28.2.5",
	"description": "Deprecated legacy theming utilities. Use design tokens and Atlassian Design System components instead.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"name": "Theme",
			"category": "Libraries",
			"status": {
				"type": "deprecated",
				"description": "Theme is deprecated. Use design tokens, Atlassian Design System components, or Top Layer as appropriate."
			}
		}
	},
	"dependencies": {
		"@atlaskit/ds-lib": "^8.0.0",
		"@atlaskit/react-compiler-gating": "^0.2.0",
		"@atlaskit/tokens": "^20.5.0",
		"@babel/runtime": "^7.0.0"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/visual-regression": "workspace:^",
		"@atlaskit/datetime-picker": "^19.3.0",
		"@atlaskit/docs": "^12.3.0",
		"@atlaskit/link": "^5.1.0",
		"@atlaskit/section-message": "^10.2.0",
		"@atlassian/workbench": "workspace:*",
		"@compiled/react": "^1.0.2",
		"@testing-library/react": "^16.3.0",
		"@types/color": "^3.0.0",
		"color": "^3.0.0",
		"jest-in-case": "^1.0.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"keywords": [
		"atlaskit",
		"css",
		"theme",
		"react",
		"ui"
	]
}
