{
	"name": "@atlaskit/teams-avatar",
	"version": "4.2.0",
	"description": "A team avatar is a visual representation of a team.",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "People and Teams Collective",
		"website": {
			"tags": [
				"platform-labs"
			],
			"name": "TeamsAvatar",
			"category": "Components"
		}
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-monorepo",
	"main": "dist/cjs/entry-points/team-avatar.js",
	"module": "dist/esm/entry-points/team-avatar.js",
	"module:es2019": "dist/es2019/entry-points/team-avatar.js",
	"types": "dist/types/entry-points/team-avatar.d.ts",
	"sideEffects": [
		"*.compiled.css"
	],
	"atlaskit:src": "src/entry-points/team-avatar.ts",
	"scripts": {
		"test:coverage": "(cd ../../.. && afm run test -- 'packages/people-and-teams/teams-avatar/src' --coverage --coverageProvider=v8 --collectCoverageFrom='[\"packages/people-and-teams/teams-avatar/src/**\", \"!packages/people-and-teams/teams-avatar/src/**/**/types.ts\", \"!packages/people-and-teams/teams-avatar/src/ui/**/styled.tsx\"]')"
	},
	"dependencies": {
		"@atlaskit/avatar": "^30.0.0",
		"@atlaskit/css": "^1.1.0",
		"@atlaskit/platform-feature-flags": "^2.2.0",
		"@atlaskit/primitives": "^22.6.0",
		"@atlaskit/react-compiler-gating": "^0.2.0",
		"@atlaskit/tokens": "^20.7.0",
		"@babel/runtime": "^7.0.0",
		"@compiled/react": "^1.0.2"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.2.0"
	},
	"devDependencies": {
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/ssr": "workspace:^",
		"@atlassian/teams-app-internal-playground": "^2.10.0",
		"@atlassian/workbench": "workspace:^",
		"@testing-library/react": "^16.3.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"wait-for-expect": "^1.2.0"
	}
}
