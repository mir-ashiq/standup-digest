{
	"name": "@atlaskit/breadcrumbs",
	"version": "17.8.7",
	"description": "Breadcrumbs are a navigation system used to show a user's location in a site or app.",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"**/*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"tags": [
				"platform-labs"
			],
			"name": "Breadcrumbs",
			"category": "Navigation",
			"subPages": [
				{
					"title": "Breadcrumbs",
					"id": "breadcrumbs",
					"status": {
						"type": "beta",
						"description": "New and ready to use. These visual updates are currently behind the feature flag: `platform_dst_breadcrumbs-refresh`. We’ll provide comms and support for any major changes."
					}
				}
			]
		}
	},
	"dependencies": {
		"@atlaskit/analytics-next": "^12.6.0",
		"@atlaskit/browser-apis": "^1.2.0",
		"@atlaskit/button": "^25.7.0",
		"@atlaskit/css": "^1.1.0",
		"@atlaskit/dropdown-menu": "^21.3.0",
		"@atlaskit/ds-lib": "^8.0.0",
		"@atlaskit/icon": "^38.0.0",
		"@atlaskit/platform-feature-flags": "^2.2.0",
		"@atlaskit/primitives": "^22.7.0",
		"@atlaskit/react-compiler-gating": "^0.2.0",
		"@atlaskit/skeleton": "^4.4.0",
		"@atlaskit/tokens": "^20.11.0",
		"@atlaskit/tooltip": "^24.4.0",
		"@babel/runtime": "^7.0.0",
		"@compiled/react": "^1.0.2"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/accessibility-testing": "workspace:^",
		"@af/integration-testing": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/docs": "^12.3.0",
		"@atlaskit/icon-lab": "^7.11.0",
		"@atlaskit/link": "^5.1.0",
		"@atlaskit/logo": "^23.3.0",
		"@atlaskit/section-message": "^10.2.0",
		"@atlaskit/select": "^23.1.0",
		"@atlassian/feature-flags-test-utils": "^1.3.0",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/testing-library": "^0.12.0",
		"@atlassian/workbench": "workspace:*",
		"jscodeshift": "^17.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"homepage": "https://atlassian.design/components/breadcrumbs/",
	"platform-feature-flags": {
		"platform_dst_breadcrumbs-refresh": {
			"type": "boolean"
		}
	}
}
