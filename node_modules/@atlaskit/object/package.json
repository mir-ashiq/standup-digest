{
	"atlassian": {
		"react-compiler": {
			"enabled": true,
			"gating": {
				"source": "@atlaskit/react-compiler-gating",
				"importSpecifierName": "isReactCompilerActivePlatform"
			}
		},
		"team": "Design System Team",
		"website": {
			"tags": [
				"platform-labs"
			],
			"name": "Object",
			"category": "Images and icons"
		}
	},
	"repository": "https://bitbucket.org/atlassian/atlassian-frontend-mirror",
	"homepage": "https://atlassian.design/components/tile/",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"module:es2019": "dist/es2019/index.js",
	"types": "dist/types/index.d.ts",
	"sideEffects": [
		"*.compiled.css"
	],
	"atlaskit:src": "src/index.tsx",
	"dependencies": {
		"@atlaskit/css": "^1.1.0",
		"@atlaskit/icon": "^38.0.0",
		"@atlaskit/icon-lab": "^7.9.0",
		"@atlaskit/primitives": "^22.5.0",
		"@atlaskit/react-compiler-gating": "^0.2.0",
		"@atlaskit/tile": "^5.0.0",
		"@atlaskit/tokens": "^20.0.0",
		"@babel/runtime": "^7.0.0",
		"@compiled/react": "^1.0.2",
		"tiny-invariant": "^1.2.0"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@af/accessibility-testing": "workspace:^",
		"@af/formatting": "workspace:^",
		"@af/visual-regression": "workspace:^",
		"@atlaskit/ds-lib": "^8.0.0",
		"@atlaskit/ssr": "workspace:^",
		"@atlassian/codegen": "^0.3.0",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/testing-library": "^0.11.0",
		"@atlassian/workbench": "workspace:*",
		"fs-extra": "^4.0.2",
		"lodash": "^4.17.21",
		"pkg-dir": "^4.2.0",
		"react": "^19.0.0",
		"react-dom": "^19.2.0",
		"ts-node": "^10.9.1"
	},
	"name": "@atlaskit/object",
	"version": "2.3.5",
	"description": "An object is an icon that represents an Atlassian-specific content type.",
	"author": "Atlassian Pty Ltd",
	"license": "Apache-2.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"codegen-objects": "ts-node --project ../../../tsconfig.node.json ./build/index.tsx"
	}
}
