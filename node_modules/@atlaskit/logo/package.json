			"tags": [
				"platform-labs"
			],
			"name": "Logo",
			"category": "Images and icons"
		}
	},
	"dependencies": {
		"@atlaskit/css": "^1.1.0",
		"@atlaskit/ds-lib": "^8.0.0",
		"@atlaskit/platform-feature-flags": "^2.2.0",
