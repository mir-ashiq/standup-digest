		"@atlaskit/code": "^20.0.0",
		"@atlaskit/docs": "^12.3.0",
		"@atlaskit/heading": "^8.0.0",
		"@atlaskit/image": "^5.2.0",
		"@atlaskit/link": "^5.1.0",
		"@atlaskit/primitives": "^22.7.0",
		"@atlaskit/section-message": "^10.2.0",
		"@atlaskit/select": "^23.2.0",
		"@atlaskit/table": "^1.3.0",
		"@atlaskit/toggle": "^17.3.0",
		"@atlassian/codegen": "^0.3.0",
		"@atlassian/feature-flags-test-utils": "^1.3.0",
		"@atlassian/ssr-tests": "workspace:^",
		"@atlassian/structured-docs-types": "workspace:^",
		"@atlassian/testing-library": "^0.12.0",
		"@atlassian/workbench": "workspace:*",
		"fs-extra": "^4.0.2",
		"jscodeshift": "^17.0.0",
		"lodash": "^4.17.21",
		"pkg-dir": "^4.2.0",
		"react": "^19.0.0",
		"react-dom": "^19.2.0",
		"svgo": "patch:svgo@npm%3A3.3.0#~/.yarn/patches/svgo-npm-3.3.0-253da0cdd6.patch",
		"ts-node": "^10.9.1"
	},
	"platform-feature-flags": {
		"assets-platform-branding": {
			"type": "boolean"
