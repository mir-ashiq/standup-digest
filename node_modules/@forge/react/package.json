{
  "name": "@forge/react",
  "version": "12.5.0",
  "description": "Forge React reconciler",
  "author": "Atlassian",
  "license": "SEE LICENSE IN LICENSE.txt",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "scripts": {
    "build": "yarn run clean && yarn run compile",
    "prebuild": "yarn run add-component-jsdoc",
    "clean": "rm -rf ./out && rm -f tsconfig.tsbuildinfo",
    "compile": "tsc -b -v",
    "pack": "./build/bundle-types.sh",
    "add-component-jsdoc": "ts-node ./build/add-component-jsdoc.ts"
  },
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "default": "./out/index.js"
    },
    "./jira": {
      "types": "./out/components/jira/index.d.ts",
      "default": "./out/components/jira/index.js"
    },
    "./global": {
      "types": "./out/components/global/index.d.ts",
      "default": "./out/components/global/index.js"
    },
    "./router": {
      "types": "./out/router/index.d.ts",
      "default": "./out/router/index.js"
    }
  },
  "dependencies": {
    "@atlaskit/adf-schema": "^56.7.0",
    "@atlaskit/adf-utils": "^20.5.12",
    "@atlaskit/forge-react-types": "^2.13.0",
    "@forge/bridge": "^7.3.0",
    "@forge/egress": "^3.0.1",
    "@forge/i18n": "1.0.1",
    "@types/react": "^18.2.64",
    "@types/react-reconciler": "^0.28.8",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-hook-form": "7.65.0",
    "react-reconciler": "^0.29.0",
    "react-test-renderer": "^18.2.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@testing-library/react-hooks": "^8.0.1",
    "expect-type": "^0.17.3",
    "history": "5.3.0",
    "ts-morph": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  },
  "publishConfig": {
    "registry": "https://packages.atlassian.com/api/npm/npm-public/"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
